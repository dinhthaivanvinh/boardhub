# Copy to .env (not committed) or export in your shell. Every value is optional in development.
PORT=4000
# Required in production (32+ characters).
JWT_SECRET=
# Comma-separated web origins. Unset in development = allow any origin (LAN play).
CORS_ORIGIN=
# Unset = in-memory (single process, data lost on restart). docker compose up -d provides both:
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://boardhub:boardhub@localhost:5432/boardhub
GRACE_MS=60000
BOT_DELAY_MS=1200
BOT_WORKERS=2
LOG_LEVEL=info
# The first super admins (registered accounts, granted at start-up while there is none).
ADMIN_EMAILS=
# Local testing only: lets you sign up with a listed address. Refused when NODE_ENV=production.
ADMIN_SELF_REGISTER=false
